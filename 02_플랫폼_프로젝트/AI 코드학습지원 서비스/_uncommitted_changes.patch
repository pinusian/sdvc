diff --git a/start-servers.bat b/start-servers.bat
index 0ab4d1c..19c31ea 100644
--- a/start-servers.bat
+++ b/start-servers.bat
@@ -1,13 +1,47 @@
 @echo off
-REM AI Code Learning Service - launch backend and frontend servers, each in its own window
+REM AI Code Learning Service - launch backend and frontend servers, each in its own window.
+REM Safe to double-click again while servers are already running: a port that is already
+REM listening is left alone instead of being started a second time (avoids duplicate /
+REM orphaned processes on the same port).
+REM
+REM NOTE: literal parentheses must NOT appear inside the if/else ( ... ) blocks below -
+REM cmd.exe parses "(" and ")" as block structure even inside echo text, so something like
+REM "echo Backend (8000) launched." breaks the parser with "was unexpected at this time".
 
 cd /d "%~dp0"
 
-start "AI Learning - Backend (8000)" powershell -NoExit -ExecutionPolicy Bypass -Command "cd '%~dp0'; backend\.venv\Scripts\Activate.ps1; python -m uvicorn backend.src.main:app --port 8000"
+REM Backend: check whether it actually RESPONDS, not just whether the port is held.
+REM A crashed "uvicorn --reload" leaves a zombie that keeps port 8000 but serves
+REM nothing - that is what makes the browser show "Request failed with status 502".
+REM curl exits 0 only if something answered on /docs; otherwise we clean + restart.
+curl -s -o nul -w "" --max-time 3 http://127.0.0.1:8000/docs
+if %ERRORLEVEL%==0 (
+    echo [SKIP] Backend already healthy on port 8000.
+) else (
+    echo [PREP] Removing any stale backend process...
+    powershell -NoProfile -Command "Get-CimInstance Win32_Process -Filter \"Name='python.exe'\" | Where-Object { $_.CommandLine -like '*backend.src.main*' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }"
+    start "AI Learning - Backend - port 8000" powershell -NoExit -ExecutionPolicy Bypass -Command "cd '%~dp0'; backend\.venv\Scripts\Activate.ps1; python -m pip install -q -r requirements.txt; python -m uvicorn backend.src.main:app --port 8000 --reload"
+    echo [START] Backend - port 8000 launched.
+)
 
-start "AI Learning - Frontend (5173)" powershell -NoExit -ExecutionPolicy Bypass -Command "cd '%~dp0webapp'; npm run dev"
+netstat -ano | findstr /R /C:":5173 .*LISTENING" >nul
+if %ERRORLEVEL%==0 (
+    echo [SKIP] Port 5173 already in use - Frontend appears to be running already.
+) else (
+    start "AI Learning - Frontend - port 5173" powershell -NoExit -ExecutionPolicy Bypass -Command "cd '%~dp0webapp'; npm run dev"
+    echo [START] Frontend - port 5173 launched.
+)
 
-start "AI Learning - Reading Activity (5174)" powershell -NoExit -ExecutionPolicy Bypass -Command "cd '%~dp0webapp-reading'; npm run dev"
+netstat -ano | findstr /R /C:":5174 .*LISTENING" >nul
+if %ERRORLEVEL%==0 (
+    echo [SKIP] Port 5174 already in use - Reading Activity appears to be running already.
+) else (
+    start "AI Learning - Reading Activity - port 5174" powershell -NoExit -ExecutionPolicy Bypass -Command "cd '%~dp0webapp-reading'; npm run dev"
+    echo [START] Reading Activity - port 5174 launched.
+)
 
-echo Backend (8000), Frontend (5173), and Reading Activity (5174) servers have been launched in separate windows.
+echo.
 echo Open http://localhost:5173 (main app) or http://localhost:5174 (reading activity) in your browser once they finish starting.
+echo (Each server runs in its own separate window - closing THIS window will NOT stop them.)
+echo.
+pause
